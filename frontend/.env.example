# Copy to .env.local for local development.

# Path prefix the site is served under (GitHub Pages project page: /<repo-name>). Empty locally.
NEXT_PUBLIC_BASE_PATH=

# Base URL of the backend API, without a trailing slash (e.g. https://api.example.org).
NEXT_PUBLIC_API_BASE=

# 1 = use built-in mock data instead of the backend.
NEXT_PUBLIC_API_MOCK=1

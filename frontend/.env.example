# Copy to .env.local for local development.

# Path prefix the site is served under (GitHub Pages project page: /<repo-name>). Empty locally.
NEXT_PUBLIC_BASE_PATH=

# Base URL of the backend API, without a trailing slash. Locally: the backend dev server
# (see ../backend/README.md); in production, the deployed API (e.g. https://api.example.org).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Google Analytics measurement ID (G-…). Empty = no consent banner and no analytics (local dev, CI, forks).
NEXT_PUBLIC_GA_ID=

# The site's origin, without a path or trailing slash (e.g. https://example.org). Used for the
# sitemap and canonical URLs. Empty = http://localhost:3000.
NEXT_PUBLIC_SITE_ORIGIN=

# Google Search Console verification token (the content of its HTML tag). Empty = no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 1 = use built-in mock data instead of the backend (no backend needed).
NEXT_PUBLIC_API_MOCK=

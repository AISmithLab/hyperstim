# Copy to .env.local for local development.

# Path prefix the site is served under (GitHub Pages project page: /<repo-name>). Empty locally.
NEXT_PUBLIC_BASE_PATH=

# Base URL of the backend API, without a trailing slash. Locally: the backend dev server
# (see ../backend/README.md); in production, the deployed API (e.g. https://api.example.org).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 1 = use built-in mock data instead of the backend (no backend needed).
NEXT_PUBLIC_API_MOCK=

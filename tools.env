# Pinned system tools (plan 010), installed in one go:
#   dev:    ./dev.sh --install-tools
#   server: sudo deploy/setup.sh
# Language packages are in frontend/package-lock.json and backend/uv.lock instead.

UV_VERSION=0.13.0
DENO_VERSION=2.9.3 # yt-dlp's JavaScript runtime for YouTube (live analysis)
NVM_VERSION=0.40.3 # dev only; Node's version is in frontend/.nvmrc
FFMPEG_VERSION=6.1.1 # the dataset was extracted with it; from the OS packages (Ubuntu 24.04)

# OS packages (apt). The server also needs a web server and envsubst for its templates.
APT_PACKAGES="ffmpeg git curl unzip"
APT_PACKAGES_SERVER="nginx gettext-base"
# macOS (Homebrew), dev only.
BREW_PACKAGES="ffmpeg"

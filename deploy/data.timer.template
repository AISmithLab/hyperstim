# Runs the daily commit of the collected dataset (plan 013). Written by deploy/setup.sh.
[Unit]
Description=HyperStim website: commit the collected dataset daily (prod)

[Timer]
# The day's last second, so the commit wraps up the UTC day, as the changelog counts them
# (commit-data.sh takes the files and the date first, before midnight).
OnCalendar=*-*-* 23:59:59 UTC
# On time: systemd's default lets a timer start up to a minute late, past midnight.
AccuracySec=1ms
# A run missed while the server was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target

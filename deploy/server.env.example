# The prod server's settings (plan 010): the only file to edit for the server setup.
# Copy to deploy/server.env (git-ignored, never commit it), fill in every <...>, then run
#   sudo deploy/setup.sh
# Run it again after any change here.

# --- The prod instance ----------------------------------------------------------------
# Folder for everything of the instance (created), e.g. /srv/<name>.
PROD_DIR="<prod-dir>"
# systemd service name, and the system user it runs as (created).
SERVICE="<service-name>"
SERVICE_USER="<service-user>"
# Free local port the API listens on (127.0.0.1 only; nginx forwards to it).
PORT="<port>"

# --- Who may release (they also need push access to the GitHub repo) -------------------
RELEASE_GROUP="<release-group>"
# Login names on this server, separated by spaces; added to the group.
RELEASERS="<login> <login>"

# --- nginx -----------------------------------------------------------------------------
# The existing site file (with TLS) of the API's host name; the API is added to it under /v2/.
NGINX_SITE="/etc/nginx/sites-available/<site>"

# --- The API's settings (backend/.env.example says what each one does) -----------------
# The site's address on GitHub Pages, without a path.
CORS_ORIGIN="https://<github-owner>.github.io"
# Secret. Restrict it in Google Cloud to the YouTube Data API and this server's IP.
YOUTUBE_API_KEY="<key>"
# Optional cookies file for yt-dlp, readable by the service user; empty = none.
YTDLP_COOKIES=""
ANALYSIS_LIMIT_PER_IP="5"
ANALYSIS_LIMIT_PER_DAY="100"

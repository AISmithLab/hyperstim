# Copy to .env for local development; on the server, set these in the service environment.

# Dataset TSV written by scripts/import_dataset.py (a videos.meta.json must sit next to it).
DATASET_PATH=data/videos.tsv

# The one origin allowed to call the API: the frontend's URL, without a trailing slash.
CORS_ORIGIN=http://localhost:3000

# Folder for live analyses: one JSON result file per video, plus each running video's
# temporary clip (deleted when done). Outside the repo on the server; locally the
# git-ignored backend/analysis/.
ANALYSIS_DIR=analysis

# Folder for cached video thumbnails (the site loads them from us, not from YouTube; each is
# fetched again after 30 days). Outside the repo on the server; locally the git-ignored
# backend/thumbnails/.
THUMBNAIL_DIR=thumbnails

# New live analyses one IP address may start per hour; 0 = no limit. Unset = 20.
# Off for local development so it doesn't get in the way of debugging.
ANALYSIS_LIMIT_PER_IP=0

# New live analyses all visitors together may start in 24 hours; 0 = no limit. Unset = 1000.
# Keeps the YouTube API quota and our downloads in bounds. Off for local development.
ANALYSIS_LIMIT_PER_DAY=0

# 1 = serve the API docs (/docs, /redoc, /openapi.json); 0 = off (production). Unset = 1.
API_DOCS=1

# YouTube Data API key, for live analysis's made-for-kids check (the dataset holds only
# videos YouTube marks as made for kids). Set it on the server. Empty = no check (local
# development). Never commit it.
YOUTUBE_API_KEY=

# Optional: a cookies file for yt-dlp (look-up and download), if YouTube asks for one.
# Never commit it.
YTDLP_COOKIES=
